    /* Chroma syntax highlighting — Gruvbox palette */
    .chroma .n { color: var(--gruvbox-ansi15) } /* Name */
    .chroma .nx { color: var(--gruvbox-ansi15) } /* NameOther */
    .chroma .ni { color: var(--gruvbox-ansi15) } /* NameEntity */
    .chroma .p { color: var(--gruvbox-ansi15) } /* Punctuation */
    .chroma .l { color: var(--gruvbox-ansi15) } /* Literal */
    .chroma .ld {} /* LiteralDate */
    .chroma .py {} /* NameProperty */
    .chroma .fm {} /* NameFunctionMagic */
    .chroma .vm {} /* NameVariableMagic */
    .chroma .gl {} /* GenericUnderline */
    .chroma .c,
    .chroma .c1,
    .chroma .ch,
    .chroma .cm,
    .chroma .cs,
    .chroma .sd {
        color: var(--gruvbox-ansi08);
        font-style: italic
    } /* Comment */
    .chroma .k,
    .chroma .kc,
    .chroma .kd,
    .chroma .kn,
    .chroma .kp,
    .chroma .kr {
        color: var(--gruvbox-ansi01)
    } /* Keyword */
    .chroma .o,
    .chroma .ow {
        color: var(--gruvbox-ansi03)
    } /* Operator */
    .chroma .s,
    .chroma .s1,
    .chroma .s2,
    .chroma .sa,
    .chroma .sb,
    .chroma .sc,
    .chroma .sh,
    .chroma .si,
    .chroma .sr,
    .chroma .ss,
    .chroma .sx,
    .chroma .dl,
    .chroma .cpf {
        color: var(--gruvbox-ansi14)
    } /* LiteralString */
    .chroma .m,
    .chroma .mb,
    .chroma .mf,
    .chroma .mh,
    .chroma .mi,
    .chroma .mo,
    .chroma .il {
        color: var(--gruvbox-ansi13)
    } /* LiteralNumber */
    .chroma .no { color: var(--gruvbox-ansi13) } /* NameConstant */
    .chroma .nl { color: var(--gruvbox-ansi13) } /* NameLabel */
    .chroma .kt,
    .chroma .nc,
    .chroma .nn {
        color: var(--gruvbox-ansi03)
    } /* Type-like */
    .chroma .nv,
    .chroma .vc,
    .chroma .vg,
    .chroma .vi {
        color: var(--gruvbox-ansi03)
    } /* Variable-like */
    .chroma .nf { color: #a9b665 } /* NameFunction */
    .chroma .nb { color: #a9b665 } /* NameBuiltin */
    .chroma .na { color: #a9b665 } /* NameAttribute */
    .chroma .bp,
    .chroma .ne,
    .chroma .nd {
        color: var(--gruvbox-ansi12)
    } /* Name labels / Preproc */
    .chroma .cp { color: var(--gruvbox-ansi12) } /* CommentPreproc */
    .chroma .se { color: var(--gruvbox-ansi12) } /* LiteralStringEscape */
    .chroma .nt { color: var(--gruvbox-ansi01) } /* NameTag */
    .chroma .gd { color: var(--gruvbox-ansi01); background-color: var(--diff-removed-row-bg) } /* GenericDeleted */
    .chroma .ge { color: var(--gruvbox-ansi15); font-style: italic } /* GenericEmph */
    .chroma .gh { color: var(--gruvbox-ansi12) } /* GenericHeading */
    .chroma .gi { color: var(--gruvbox-ansi02); background-color: var(--diff-added-row-bg) } /* GenericInserted */
    .chroma .go { color: var(--gruvbox-ansi08) } /* GenericOutput */
    .chroma .gp { color: var(--gruvbox-ansi15); font-weight: bold } /* GenericPrompt */
    .chroma .gr { color: var(--gruvbox-ansi01) } /* GenericError */
    .chroma .gs { color: var(--gruvbox-ansi15); font-weight: bold } /* GenericStrong */
    .chroma .gt { color: var(--gruvbox-ansi01) } /* GenericTraceback */
    .chroma .gu { color: var(--gruvbox-ansi08) } /* GenericSubheading */
    .chroma .w { color: var(--gruvbox-ansi08) } /* TextWhitespace */
    .chroma .err {} /* Error — not styled, too many false positives */

