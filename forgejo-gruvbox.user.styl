@preprocessor   stylus
@license        CC-BY-SA-4.0

@var select theme-variant "Gruvbox variant" {
    'Light Soft' : 'light-soft-theme-variant',
    'Light' : 'light-theme-variant',
    'Light Hard': 'light-hard-theme-variant',
    'Dark Soft' : 'dark-soft-theme-variant',
    'Dark' : 'dark-theme-variant',
    'Dark Hard': 'dark-hard-theme-variant'
}

==/UserStyle== */
