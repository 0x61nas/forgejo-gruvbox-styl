/* ==UserStyle==
@name           Forgejo Gruvbox
@namespace      https://github.com/0x61nas
@version        1.0.2
@description     Customizable Gruvbox color scheme for Forgejo frontend
@author         Anas Elgarhy <anas.elgarhy.dev@gmail.com>
@homepageURL    https://github.com/0x61nas/forgejo-gruvbox-styl
@supportURL     https://github.com/0x61nas/forgejo-gruvbox-styl/issues
@updateURL      https://raw.githubusercontent.com/0x61nas/forgejo-gruvbox-styl/aurora/forgejo-gruvbox.user.styl
@preprocessor   stylus
@license        CC-BY-SA-4.0

@var select theme-variant "Gruvbox variant" {
    'Light Soft' : 'light-soft-theme-variant',
    'Light' : 'light-theme-variant',
    'Light Hard': 'light-hard-theme-variant',
    'Dark Soft' : 'dark-soft-theme-variant',
    'Dark' : 'dark-theme-variant',
    'Dark Hard': 'dark-hard-theme-variant'
}

==/UserStyle== */
